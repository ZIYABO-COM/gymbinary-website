# Get a free API key at https://resend.com after verifying a sending domain
# (or use their onboarding@resend.dev sender for quick testing, limited to your own inbox)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where demo requests get emailed to (your inbox)
DEMO_NOTIFY_EMAIL=owner@yourgym.com

# Optional — must be on a domain you've verified in Resend.
# Defaults to Resend's shared test sender if not set.
DEMO_FROM_EMAIL=Gym Binary <demo@yourdomain.com>
