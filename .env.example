# Complete application login URL (not only its hostname).
NEXT_PUBLIC_APP_URL=https://app.gymbinary.com/login
# Configure Resend and verify the sending domain before enabling email delivery.
RESEND_API_KEY=
DEMO_FROM_EMAIL=GymBinary <contact@gymbinary.com>
DEMO_NOTIFY_EMAIL=contact@gymbinary.com
# Enable only behind a proxy that overwrites, rather than appends untrusted, X-Forwarded-For.
DEMO_TRUST_PROXY=false
